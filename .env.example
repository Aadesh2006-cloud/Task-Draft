# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret used to sign local email/password session tokens.
# Replace with a strong random string in production.
SESSION_SECRET="CHANGE_ME_LOCAL_DEV_SESSION_SECRET"

# Cloud SQL PostgreSQL connection variables (injected automatically in AI Studio / Cloud Run)
SQL_HOST="127.0.0.1"
SQL_DB_NAME="briefline"
SQL_USER="app_user"
SQL_PASSWORD="CHANGE_ME"
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="CHANGE_ME"
