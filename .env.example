# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL credentials (injected by runtime)
SQL_HOST="127.0.0.1"
SQL_USER="app_user"
SQL_PASSWORD="MY_SQL_PASSWORD"
SQL_DB_NAME="briefline"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="MY_SQL_ADMIN_PASSWORD"

# Session signing secret for email/password authentication
SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# Supabase Backend Configuration (Server-side secret key must NEVER use VITE_ prefix)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="MY_SUPABASE_PUBLISHABLE_KEY"
SUPABASE_SECRET_KEY="MY_SUPABASE_SECRET_KEY"

# Supabase Client Configuration (Publishable key only)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="MY_SUPABASE_PUBLISHABLE_KEY"
