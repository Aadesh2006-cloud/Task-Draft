rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global hardened primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'kanugarg2006@gmail.com'
      );
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfileFields(data, userId) {
      return data.uid is string && isValidId(data.uid) && data.uid == userId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.activeRole is string && data.activeRole in ['buyer', 'seller'] &&
        data.canBuy is bool &&
        data.canSell is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidUserProfileCreate(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'email', 'activeRole', 'canBuy', 'canSell', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'name', 'email', 'activeRole', 'canBuy', 'canSell', 'createdAt', 'updatedAt']) &&
        isValidUserProfileFields(data, userId) &&
        data.createdAt == request.time;
    }

    function isValidUserProfileUpdate(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'email', 'activeRole', 'canBuy', 'canSell', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'name', 'email', 'activeRole', 'canBuy', 'canSell', 'createdAt', 'updatedAt']) &&
        isValidUserProfileFields(data, userId);
    }

    // Validation Blueprint: ProjectBriefSync
    function isValidSkillsList(skills) {
      return skills is list && skills.size() <= 15 &&
        (skills.size() == 0 || (skills[0] is string && skills[0].size() >= 1 && skills[0].size() <= 60));
    }

    function isValidProjectBriefFields(data, briefId) {
      return data.briefId is string && isValidId(data.briefId) && data.briefId == briefId &&
        data.buyerUid is string && isValidId(data.buyerUid) &&
        data.projectId is int && data.projectId > 0 &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 180 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.subcategory is string && data.subcategory.size() <= 80 &&
        data.budgetType is string && data.budgetType in ['fixed', 'hourly'] &&
        data.budgetMin is int && data.budgetMin >= 0 && data.budgetMin <= 10000000 &&
        data.budgetMax is int && data.budgetMax >= 0 && data.budgetMax <= 10000000 &&
        data.currency is string && data.currency.size() >= 3 && data.currency.size() <= 6 &&
        data.status is string && data.status in ['draft', 'open', 'paused', 'hired', 'closed', 'cancelled'] &&
        isValidSkillsList(data.skills) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidProjectBriefCreate(data, briefId) {
      return data.keys().hasAll([
          'briefId', 'buyerUid', 'projectId', 'title', 'category', 'subcategory',
          'budgetType', 'budgetMin', 'budgetMax', 'currency', 'status', 'skills',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'briefId', 'buyerUid', 'projectId', 'title', 'category', 'subcategory',
          'budgetType', 'budgetMin', 'budgetMax', 'currency', 'status', 'skills',
          'createdAt', 'updatedAt'
        ]) &&
        isValidProjectBriefFields(data, briefId) &&
        data.buyerUid == request.auth.uid &&
        data.createdAt == request.time;
    }

    function isValidProjectBriefUpdate(data, briefId) {
      return data.keys().hasAll([
          'briefId', 'buyerUid', 'projectId', 'title', 'category', 'subcategory',
          'budgetType', 'budgetMin', 'budgetMax', 'currency', 'status', 'skills',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'briefId', 'buyerUid', 'projectId', 'title', 'category', 'subcategory',
          'budgetType', 'budgetMin', 'budgetMax', 'currency', 'status', 'skills',
          'createdAt', 'updatedAt'
        ]) &&
        isValidProjectBriefFields(data, briefId);
    }

    // Validation Blueprint: WorkspaceEvent
    function isValidWorkspaceEventCreate(data, eventId) {
      return data.keys().hasAll([
          'eventId', 'workspaceId', 'buyerUid', 'sellerUid', 'actorUid',
          'eventType', 'summary', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'eventId', 'workspaceId', 'buyerUid', 'sellerUid', 'actorUid',
          'eventType', 'summary', 'createdAt'
        ]) &&
        data.eventId is string && isValidId(data.eventId) && data.eventId == eventId &&
        data.workspaceId is int && data.workspaceId > 0 &&
        data.buyerUid is string && isValidId(data.buyerUid) &&
        data.sellerUid is string && isValidId(data.sellerUid) &&
        data.actorUid is string && isValidId(data.actorUid) &&
        data.actorUid == request.auth.uid &&
        (data.actorUid == data.buyerUid || data.actorUid == data.sellerUid) &&
        data.eventType is string && data.eventType.size() >= 1 && data.eventType.size() <= 60 &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500 &&
        data.createdAt is timestamp &&
        data.createdAt == request.time;
    }

    // Admin registry: strictly read-own only, no client writes
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isOwner(adminId);
      allow list, create, update, delete: if false;
    }

    // User profiles: strict PII isolation to owner or admin
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfileCreate(incoming(), userId);
      allow update: if isValidId(userId) &&
        isValidUserProfileUpdate(incoming(), userId) && (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().uid == existing().uid &&
            incoming().email == existing().email &&
            incoming().createdAt == existing().createdAt &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'activeRole', 'canBuy', 'canSell', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Project briefs mirrored to Firestore
    match /project_briefs/{briefId} {
      allow get: if isValidId(briefId) && (
        existing().status == 'open' ||
        (isVerifiedUser() && existing().buyerUid == request.auth.uid) ||
        isAdmin()
      );
      allow list: if existing().status == 'open' ||
        (isVerifiedUser() && existing().buyerUid == request.auth.uid);
      allow create: if isValidId(briefId) && isVerifiedUser() && isValidProjectBriefCreate(incoming(), briefId);
      allow update: if isValidId(briefId) &&
        isValidProjectBriefUpdate(incoming(), briefId) && (
          isAdmin() ||
          (
            isVerifiedUser() &&
            existing().buyerUid == request.auth.uid &&
            existing().status != 'closed' &&
            existing().status != 'cancelled' &&
            incoming().briefId == existing().briefId &&
            incoming().buyerUid == existing().buyerUid &&
            incoming().projectId == existing().projectId &&
            incoming().createdAt == existing().createdAt &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'category', 'subcategory', 'budgetType', 'budgetMin',
              'budgetMax', 'currency', 'status', 'skills', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(briefId) && isAdmin();
    }

    // Private workspace activity events (participant-only, append-only)
    match /workspace_events/{eventId} {
      allow get: if isValidId(eventId) && (
        isAdmin() ||
        (isVerifiedUser() && (existing().buyerUid == request.auth.uid || existing().sellerUid == request.auth.uid))
      );
      allow list: if isVerifiedUser() &&
        (existing().buyerUid == request.auth.uid || existing().sellerUid == request.auth.uid);
      allow create: if isValidId(eventId) && isVerifiedUser() && isValidWorkspaceEventCreate(incoming(), eventId);
      allow update, delete: if false;
    }
  }
}
